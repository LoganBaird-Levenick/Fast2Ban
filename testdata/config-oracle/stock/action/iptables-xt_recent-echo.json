   5
  ],
  [
   "set",
   "o-a-iptables-xt_recent-echo",
   "maxmatches",
   5
  ],
  [
   "set",
   "o-a-iptables-xt_recent-echo",
   "findtime",
   "10m"
  ],
  [
   "set",
   "o-a-iptables-xt_recent-echo",
   "bantime",
   "10m"
  ],
  [
   "set",
   "o-a-iptables-xt_recent-echo",
   "ignorecommand",
   ""
  ],
  [
   "set",
   "o-a-iptables-xt_recent-echo",
   "logencoding",
   "auto"
  ],
  [
   "set",
   "o-a-iptables-xt_recent-echo",
   "addlogpath",
   "/dev/null",
   "head"
  ],
  [
   "set",
   "o-a-iptables-xt_recent-echo",
   "addaction",
   "iptables-xt_recent-echo"
  ],
  [
   "multi-set",
   "o-a-iptables-xt_recent-echo",
   "action",
   "iptables-xt_recent-echo",
   [
    [
     "actionstart",
     "if [ `id -u` -eq 0 ];then\n{ <iptables> -C INPUT -m recent --update --seconds 3600 --name <iptname> -j <blocktype> >/dev/null 2>&1; } || { <iptables> -I INPUT -m recent --update --seconds 3600 --name <iptname> -j <blocktype>; }\nfi"
    ],
    [
     "actionstop",
     "echo / > /proc/net/xt_recent/<iptname>\nif [ `id -u` -eq 0 ];then\n<iptables> -D INPUT -m recent --update --seconds 3600 --name <iptname> -j <blocktype>;\nfi"
    ],
    [
     "actionflush",
     ""
    ],
    [
     "actioncheck",
     "{ <iptables> -C INPUT -m recent --update --seconds 3600 --name <iptname> -j <blocktype> >/dev/null 2>&1; } && test -e /proc/net/xt_recent/<iptname>"
    ],
    [
     "actionban",
     "echo +<ip> > /proc/net/xt_recent/<iptname>"
    ],
    [
     "actionunban",
     "echo -<ip> > /proc/net/xt_recent/<iptname>"
    ],
    [
     "name",
     "o-a-iptables-xt_recent-echo"
    ],
    [
     "actname",
     "iptables-xt_recent-echo"
    ],
    [
     "chain",
     "INPUT"
    ],
    [
     "port",
     "ssh"
    ],
    [
     "protocol",
     "tcp"
    ],
    [
     "blocktype",
     "REJECT --reject-with icmp-port-unreachable"
    ],
    [
     "returntype",
     "RETURN"
    ],
    [
     "lockingopt",
     "-w"
    ],
    [
     "iptables",
     "iptables <lockingopt>"
    ],
    [
     "blocktype?family=inet6",
     "REJECT --reject-with icmp6-port-unreachable"
    ],
    [
     "iptables?family=inet6",
     "ip6tables <lockingopt>"
    ],
    [
     "iptname",
     "f2b-<name>"
    ],
    [
     "iptname?family=inet6",
     "f2b-<name>6"
    ]
   ]
  ],
  [
   "start",
   "o-a-iptables-xt_recent-echo"
  ]
 ],
 "files": {
