   "iptables-allports-tcp",
   [
    [
     "actionstart",
     "{ <iptables> -C f2b-nsd-tcp -j RETURN >/dev/null 2>&1; } || { <iptables> -N f2b-nsd-tcp || true; <iptables> -A f2b-nsd-tcp -j RETURN; }\nfor chain in $(echo 'INPUT' | sed 's/,/ /g'); do for proto in $(echo 'tcp' | sed 's/,/ /g'); do\n{ <iptables> -C $chain -p $proto -j f2b-nsd-tcp >/dev/null 2>&1; } || { <iptables> -I $chain -p $proto -j f2b-nsd-tcp; }\ndone; done"
    ],
    [
     "actionstop",
     "for chain in $(echo 'INPUT' | sed 's/,/ /g'); do for proto in $(echo 'tcp' | sed 's/,/ /g'); do\n<iptables> -D $chain -p $proto -j f2b-nsd-tcp\ndone; done\n<iptables> -F f2b-nsd-tcp\n<iptables> -X f2b-nsd-tcp"
    ],
    [
     "actionflush",
     "<iptables> -F f2b-nsd-tcp"
    ],
    [
     "actioncheck",
     "for chain in $(echo 'INPUT' | sed 's/,/ /g'); do for proto in $(echo 'tcp' | sed 's/,/ /g'); do\n<iptables> -C $chain -p $proto -j f2b-nsd-tcp\ndone; done"
    ],
    [
     "actionban",
     "<iptables> -I f2b-nsd-tcp 1 -s <ip> -j <blocktype>"
    ],
    [
     "actionunban",
     "<iptables> -D f2b-nsd-tcp -s <ip> -j <blocktype>"
    ],
    [
     "port",
